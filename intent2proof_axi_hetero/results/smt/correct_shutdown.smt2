(set-logic QF_LIA)
(declare-fun q0 () Int)
(declare-fun q1 () Int)
(declare-fun b0 () Int)
(declare-fun b1 () Int)
(declare-fun req0 () Int)
(declare-fun req1 () Int)
(declare-fun a0 () Int)
(declare-fun a1 () Int)
(declare-fun r0 () Int)
(declare-fun r1 () Int)
(assert (<= 0 q0 1))
(assert (<= 0 q1 1))
(assert (= q0 b0))
(assert (= q1 b1))
(assert (<= 0 req0 1))
(assert (<= 0 req1 1))
(assert (<= 0 a0 1))
(assert (<= 0 a1 1))
(assert (<= 0 r0 1))
(assert (<= 0 r1 1))
(assert (<= (+ a0 a1) 1))
(assert (<= (+ r0 r1) 1))
(assert (=> (= a0 1) (= q0 0)))
(assert (=> (= a1 1) (= q1 0)))
(assert (=> (= r0 1) (= q0 1)))
(assert (=> (= r1 1) (= q1 1)))
(assert (=> (= a0 1) (= r0 0)))
(assert (=> (= a1 1) (= r1 0)))
(assert (=> (= (+ q0 q1) 1) (= (+ a0 a1) 0)))
(assert (and (= req0 0) (= req1 0) (= b0 0) (= b1 0) (> (+ q0 q1) 0)))
(check-sat)
