(set-logic QF_BV)
(declare-fun fa () (_ BitVec 3))
(declare-fun fb () (_ BitVec 3))
(declare-fun fs () (_ BitVec 3))
(declare-fun pending () (_ BitVec 5))
(declare-fun reqa () Bool)
(declare-fun reqb () Bool)
(declare-fun drain () Bool)
(declare-fun shutdown () Bool)
(declare-fun latched () Bool)
(declare-fun priority_b () Bool)
(assert (= pending (bvadd ((_ zero_extend 2) fa) ((_ zero_extend 2) fb) ((_ zero_extend 2) fs))))
(assert (bvule fa (_ bv4 3)))
(assert (bvule fb (_ bv4 3)))
(assert (bvule fs (_ bv4 3)))
(assert (and latched (= fa (_ bv0 3)) (= fb (_ bv0 3)) (not (= pending (_ bv0 5)))))
(check-sat)
