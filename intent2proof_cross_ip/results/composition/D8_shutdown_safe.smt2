(set-logic QF_BV)
(declare-fun fa () (_ BitVec 4))
(declare-fun fb () (_ BitVec 4))
(declare-fun fs () (_ BitVec 4))
(declare-fun pending () (_ BitVec 6))
(declare-fun reqa () Bool)
(declare-fun reqb () Bool)
(declare-fun drain () Bool)
(declare-fun shutdown () Bool)
(declare-fun latched () Bool)
(declare-fun priority_b () Bool)
(assert (= pending (bvadd ((_ zero_extend 2) fa) ((_ zero_extend 2) fb) ((_ zero_extend 2) fs))))
(assert (bvule fa (_ bv8 4)))
(assert (bvule fb (_ bv8 4)))
(assert (bvule fs (_ bv8 4)))
(assert (and latched (= fa (_ bv0 4)) (= fb (_ bv0 4)) (= fs (_ bv0 4)) (not (= pending (_ bv0 6)))))
(check-sat)
