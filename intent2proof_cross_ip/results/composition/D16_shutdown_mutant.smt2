(set-logic QF_BV)
(declare-fun fa () (_ BitVec 5))
(declare-fun fb () (_ BitVec 5))
(declare-fun fs () (_ BitVec 5))
(declare-fun pending () (_ BitVec 7))
(declare-fun reqa () Bool)
(declare-fun reqb () Bool)
(declare-fun drain () Bool)
(declare-fun shutdown () Bool)
(declare-fun latched () Bool)
(declare-fun priority_b () Bool)
(assert (= pending (bvadd ((_ zero_extend 2) fa) ((_ zero_extend 2) fb) ((_ zero_extend 2) fs))))
(assert (bvule fa (_ bv16 5)))
(assert (bvule fb (_ bv16 5)))
(assert (bvule fs (_ bv16 5)))
(assert (and latched (= fa (_ bv0 5)) (= fb (_ bv0 5)) (not (= pending (_ bv0 7)))))
(check-sat)
